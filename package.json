{
  "name": "bkk-3d-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bangkok 3D atlas — in-browser viewer with quick-jump to historic cores, on Cloudflare Workers. Reusable 3D building data for Chula/UNL and other dashboards.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config wrangler.cron.toml && wrangler deploy",
    "deploy:live": "bash scripts/deploy-live.sh",
    "typecheck": "tsc --noEmit",
    "test:flood": "node --test scripts/test-flood-integrity.mjs",
    "test:massing": "node --test scripts/test-building-massing.mjs",
    "build:palace": "node scripts/palace-standin.mjs",
    "verify": "node scripts/verify-local.mjs",
    "smoke": "node scripts/smoke-atlas-api.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "pmtiles": "^4.4.1"
  }
}
