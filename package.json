{
  "name": "bkk-3d-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bangkok 3D atlas \u2014 in-browser viewer with quick-jump to historic cores, on Cloudflare Workers. Reusable 3D building data for Chula/UNL and other dashboards.",
  "scripts": {
    "test": "node --test scripts/test-*.mjs",
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy-live.sh",
    "deploy:live": "bash scripts/deploy-live.sh",
    "typecheck": "tsc --noEmit",
    "test:flood": "node --test scripts/test-flood-integrity.mjs",
    "test:history": "node --test scripts/test-hii-history.mjs",
    "test:sources": "node --test scripts/test-source-health.mjs",
    "test:place": "node --test scripts/test-place-briefing.mjs",
    "test:wall": "node --test scripts/test-camera-wall.mjs",
    "test:twin": "node --test scripts/test-twin-pilot.mjs",
    "photos:check": "node scripts/photo-intake.mjs",
    "reconstruct:landmark": "node scripts/reconstruct-landmark.mjs",
    "build:history": "node scripts/build-hii-history.mjs",
    "test:massing": "node --test scripts/test-building-massing.mjs",
    "build:palace": "node scripts/palace-standin.mjs",
    "verify": "node scripts/verify-local.mjs",
    "render-check": "node scripts/render-check.mjs",
    "smoke": "node scripts/smoke-atlas-api.mjs",
    "release": "bash scripts/deploy-live.sh",
    "stamp": "node scripts/stamp-build-id.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "pmtiles": "^4.4.1"
  }
}
