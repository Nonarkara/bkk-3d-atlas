# Cloudflare Workers [assets] honors _headers like Pages (2024-Q3+).
# One block for the whole site. The CSP is derived from the client code's
# actual origin inventory (grep public/ for https:// hosts), not from a
# guess: scripts lock to unpkg + jsdelivr pinned versions; styles to self +
# unpkg + inline (app.js paints `style="--h:%"` on live tiles); tiles,
# imagery, feeds and API fetches stay open in read-only categories
# (img-src/connect-src https:) because a map legitimately reaches many
# hosts — the risky surface is script/style, and those are pinned.
# inventory. Cloudflare's own analytics beacon (cloudflareinsights.com,
# auto-injected per zone dashboard setting) is explicitly allowed —
# unlisted it would be blocked, silently killing the live web analytics.
# fonts.googleapis.com (style-src) and fonts.gstatic.com (font-src) belong to
# /labs/paper/, which loads IBM Plex Sans Thai, IBM Plex Mono and Spectral from
# Google Fonts. Without them the paper rendered in fallback fonts and nothing
# said so — it looked fine, it was just not set in its own type. Verified
# blocked against the live site before this line changed. From PR #18.
# The script-src import-map hash is NOT from that PR and stays: it is what lets
# three.js load, and dropping it silently kills the 3D layers.
# Strict-Transport-Security is below, on the static document, not only on the
# Worker's own responses via src/edge-guard.ts. HSTS is honoured per host, so a
# browser that only ever loaded / would never pin this one — the header that
# matters most was on the responses that matter least. Comments in this file
# live at column 0; an indented one inside a block is not reliably a comment.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-cmpV4hrEPQ1DKRl6ZrWTySDX/rFjTNep0fTdknNSyC8=' https://unpkg.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' https: data: blob:; font-src 'self' https://tiles.openfreemap.org https://fonts.gstatic.com data:; connect-src 'self' https:; worker-src 'self' blob:; media-src 'self' blob: https://camerai1.iticfoundation.org; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/app.js
  Cache-Control: no-cache

/traffic-vision.js
  Cache-Control: no-cache

# The vehicle-count pilot's model needs eval. It runs only inside this worker,
# under its own policy; the page policy above stays eval-free.
/vision-worker.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src https://storage.googleapis.com
  Cache-Control: no-cache

# Pinned by version in the path, so safe to cache for a year.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
