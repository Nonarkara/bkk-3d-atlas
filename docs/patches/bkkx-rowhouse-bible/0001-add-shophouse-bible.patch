+import type { Metadata } from "next";
+import Link from "next/link";
+import { PlaceMasthead } from "../../PlaceMasthead";
+import catalog from "../../../public/rowhouses/bible/catalog.json";
+
+export const metadata: Metadata = {
+  title: "The row is the city — shophouse bible",
+  description:
+    "Working paper 02 and recovered thesis catalog for Bangkok shophouses. Four inventories kept separate: Onsawangchai 1,656, CPB 1,960, corridor published counts, Overture review queue.",
+  alternates: { canonical: "/rowhouses/bible" },
+  openGraph: {
+    title: "The row is the city — a Bangkok shophouse bible",
+    description: "1,656 surveyed units, 44 groups, five plans, three landlords — taken off the shelf and put on the map.",
+    url: "https://bkk.nonarkara.org/rowhouses/bible",
+  },
+};
+
+const theses = catalog.sections.filter((section) => section.id !== "E").flatMap((section) => section.entries);
+const papers = catalog.sections.find((section) => section.id === "E")?.entries ?? [];
+const phds = theses.filter((entry) => entry.phd);
+
+export default function ShophouseBiblePage() {
+  return (
+    <div className="register rowhouse-directory">
+      <PlaceMasthead />
+      <header className="rowhouse-directory-hero">
+        <p className="register-eyebrow">Working paper 02 · ตึกแถว · the shelf</p>
+        <h1>The row is the city.</h1>
+        <p className="rowhouse-directory-th" lang="th">ตึกแถวคือเมือง</p>
+        <p className="rowhouse-directory-dek">
+          The map locates corridors. This page is the scholarship those corridors
+          sit on — and the inventories that must not be added together.
+        </p>
+        <div className="rowhouse-directory-stats" aria-label="Bible summary">
+          <div><strong>1,656</strong><span>Onsawangchai 2001–02 units</span></div>
+          <div><strong>1,960</strong><span>CPB heritage bays · 15 sites</span></div>
+          <div><strong>{theses.length}</strong><span>recovered theses</span></div>
+          <div><strong>{phds.length}</strong><span>dissertations marked PhD</span></div>
+        </div>
+        <div className="rowhouse-directory-actions">
+          <a href="/rowhouses/bible/paper.html">Read the full paper</a>
+          <a href="/rowhouses/bible/theses.html">Open the thesis shelf</a>
+          <Link href="/rowhouses">Back to the map directory</Link>
+          <Link href="/?view=rowhouses">Open the 3D map</Link>
+        </div>
+      </header>
+
+      <section className="rowhouse-method" aria-labelledby="inventories-title">
+        <div>
+          <p className="register-eyebrow">Hard boundary</p>
+          <h2 id="inventories-title">Four inventories. Not one total.</h2>
+        </div>
+        <div className="rowhouse-method-grid">
+          <p>
+            <strong>Onsawangchai &amp; Funo 2004.</strong> Walked Rattanakosin in
+            2001–02. <strong>1,656 remaining shophouse units</strong>, 44 façade
+            families, five plans, three landlords. AIJ 577 and 586. This is the
+            best city-core field count we have. It is twenty-five years old.
+          </p>
+          <p>
+            <strong>Crown Property Bureau.</strong> 15 shophouse sites,{" "}
+            <strong>1,960 units</strong> in the CPB heritage inventory. Overlap
+            with the 2001–02 survey is not a join. Do not add 1,656 + 1,960.
+          </p>
+          <p>
+            <strong>Corridor published counts.</strong> Six papers name unit
+            numbers on mapped ensembles (Tha Tien 490, Sam Phraeng 119,
+            Bowonniwet 46, Khao Hong 9, Asdang–Ban Mo 108, Srasong–Longtha 98).
+            ICCROM’s Luenrit case adds ~220. Those figures are not one survey.
+            Summing the six papers into “870 academically counted units” was
+            the original sin of the first directory hero.
+          </p>
+          <p>
+            <strong>Overture review queue.</strong> 2,311 present-day shapes near
+            the 29 corridors, of which 1,001 score as strong morphology. They are
+            not heritage designations. The 1988 composition study (14,421 units)
+            calibrates shape only.
+          </p>
+        </div>
+      </section>
+
+      <section className="onep-coverage" aria-labelledby="shelf-title">
+        <div className="onep-coverage-intro">
+          <div>
+            <p className="register-eyebrow">The shelf · recovered catalog</p>
+            <h2 id="shelf-title">42 theses, not 55 invented ones.</h2>
+          </div>
+          <div>
+            <p>
+              Perplexity claimed 55 graduate theses plus 3 papers. The thread is
+              gated. This catalog recovers what named authors and university
+              repositories actually give: {theses.length} theses and {papers.length}{" "}
+              KMUTT papers. Direct PDF versus repository is a field. Incomplete
+              metadata stays marked. The six named PhDs are included.
+            </p>
+            <a href="/rowhouses/bible/theses.html">Browse every recovered record ↗</a>
+          </div>
+        </div>
+        <div className="onep-coverage-stats" aria-label="Catalog recovery">
+          {catalog.sections.map((section) => (
+            <div key={section.id}>
+              <strong>{section.entries.length}{section.claimed != null ? `/${section.claimed}` : ""}</strong>
+              <span>{section.id} · {section.title}</span>
+            </div>
+          ))}
+        </div>
+        <div className="onep-ledger">
+          <details open>
+            <summary><span>Named PhD dissertations</span><small>{phds.length} recovered</small></summary>
+            <div className="onep-ledger-table" role="table" aria-label="Named PhD dissertations">
+              {phds.map((entry) => (
+                <div className="onep-ledger-row" role="row" key={entry.id}>
+                  <code role="cell">{entry.id}</code>
+                  <div role="cell">
+                    <strong>{entry.titleEn || entry.titleTh}</strong>
+                    {entry.titleTh && entry.titleEn ? <small lang="th">{entry.titleTh}</small> : null}
+                  </div>
+                  <span role="cell">{entry.author || "not fully verified"}</span>
+                  <span role="cell">{entry.university}{entry.year ? ` · ${entry.year}` : ""}</span>
+                  <div role="cell" className="is-mapped">
+                    <a href={entry.url} target="_blank" rel="noreferrer">
+                      {entry.access === "direct-pdf" ? "Direct PDF" : "Repository"}
+                    </a>
+                  </div>
+                </div>
+              ))}
+            </div>
+          </details>
+        </div>
+        <p className="onep-coverage-note">
+          Machine-readable source: <a href="/rowhouses/bible/catalog.json">catalog.json</a>.
+          Do not cite Perplexity as the authority.
+        </p>
+      </section>
+
+      <section className="rowhouse-method" aria-labelledby="meta-title">
+        <div>
+          <p className="register-eyebrow">Seven arguments</p>
+          <h2 id="meta-title">What the literature is actually saying.</h2>
+        </div>
+        <div className="rowhouse-method-grid">
+          <p><strong>Import.</strong> Singapore 1859, Charoen Krung 1861. Not indigenous Rattanakosin fabric.</p>
+          <p><strong>Typology.</strong> 44 façade groups collapse to five plans A–E.</p>
+          <p><strong>Ordinary heritage.</strong> Fine Arts gazettes monuments. The row is everyday fabric.</p>
+          <p><strong>Landlord.</strong> CPB 46.56% of remaining surveyed units. The monarchy’s property office is the largest landlord of the type.</p>
