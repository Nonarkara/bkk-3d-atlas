+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 420" role="img" aria-labelledby="t d">
+  <title id="t">Section through a Bangkok shophouse</title>
+  <desc id="d">Ground floor shop opening to the street; stair and airwell in the middle; dwelling above; rear service court. No mandatory five-foot arcade.</desc>
+  <rect width="720" height="420" fill="#f1efe8"/>
+  <text x="24" y="28" font-family="ui-monospace, monospace" font-size="11" letter-spacing="2" fill="#c9a227">FIG. 02 � SECTION</text>
+  <text x="24" y="52" font-family="Georgia, serif" font-size="20" font-weight="700" fill="#11120f">Live-work, not a fa�ade</text>
+  <!-- street -->
+  <rect x="24" y="340" width="120" height="28" fill="#d8d4c8"/>
+  <text x="84" y="358" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#5b5d54">STREET</text>
+  <!-- building mass -->
+  <rect x="144" y="88" width="420" height="280" fill="none" stroke="#11120f" stroke-width="2"/>
+  <!-- floors -->
+  <line x1="144" y1="178" x2="564" y2="178" stroke="#11120f" stroke-width="1"/>
+  <line x1="144" y1="258" x2="564" y2="258" stroke="#11120f" stroke-width="1"/>
+  <!-- shop opening -->
+  <rect x="144" y="268" width="70" height="100" fill="#c9ff38" stroke="#11120f"/>
+  <text x="179" y="322" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10">SHOP</text>
+  <!-- stair -->
+  <path d="M250 368 L250 268 L290 268 L290 178 L330 178 L330 88" fill="none" stroke="#11120f" stroke-width="2"/>
+  <text x="270" y="248" font-family="ui-monospace, monospace" font-size="10" fill="#5b5d54">STAIR</text>
+  <!-- airwell -->
+  <rect x="360" y="98" width="70" height="250" fill="#e8f4ff" stroke="#11120f" stroke-dasharray="4 3"/>
+  <text x="395" y="230" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#3b5cdb">AIRWELL</text>
+  <!-- dwelling -->
+  <text x="220" y="140" font-family="Georgia, serif" font-size="13" fill="#11120f">dwelling</text>
+  <text x="220" y="220" font-family="Georgia, serif" font-size="13" fill="#11120f">stock / family</text>
+  <!-- rear -->
+  <rect x="564" y="300" width="80" height="68" fill="#efe8d8" stroke="#11120f"/>
+  <text x="604" y="338" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9">REAR</text>
+  <text x="604" y="352" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9">e3 m*</text>
+  <text x="24" y="396" font-family="Georgia, serif" font-size="12" font-style="italic" fill="#5b5d54">Schematic, not a measured drawing. *Rear open space is a 1979 code rule; pre-code temple rows often have none. Bangkok never required Singapores five-foot arcade.</text>
+</svg>
