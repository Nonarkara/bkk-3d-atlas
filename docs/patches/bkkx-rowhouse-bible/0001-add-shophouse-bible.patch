+    <text x="136" y="214" font-size="10" fill="#8a8c82">Onsawangchai &amp; Funo</text>
+    <rect x="260" y="80" width="200" height="160" fill="#c9a227"/>
+    <text x="360" y="140" font-size="36" font-weight="700" fill="#11120f">1,960</text>
+    <text x="360" y="168" font-size="11" fill="#11120f">CPB HERITAGE UNITS</text>
+    <text x="360" y="186" font-size="11" fill="#11120f">15 sites � early 2000s</text>
+    <text x="360" y="214" font-size="10" fill="#3a3a32">Yongtanit 2012 / CPB 2004</text>
+    <rect x="484" y="80" width="200" height="160" fill="#c9ff38" stroke="#11120f"/>
+    <text x="584" y="140" font-size="36" font-weight="700" fill="#11120f">9,275</text>
