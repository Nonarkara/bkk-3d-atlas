diff --git a/site/public/rowhouses/bible/paper.css b/site/public/rowhouses/bible/paper.css
new file mode 100644
index 0000000..e3f04a3
--- /dev/null
+++ b/site/public/rowhouses/bible/paper.css
@@ -0,0 +1,410 @@
+/* BKKx Labs research paper — the "BKKx Law Review" companion to
+   the 3D atlas. The aesthetic is the MoMA / Spectral Law style
+   we use on the BKKx proposal — paper background, Spectral serif
+   for the body, IBM Plex for the inline code, sharp edges, no
+   shadows. The thesis is serious, the typography carries it. */
+
+:root {
+  --paper-bg: #f1efe8;
+  --paper-ink: #11120f;
+  --paper-muted: #5b5d54;
+  --paper-rule: rgba(17, 18, 15, 0.16);
+  --paper-signal: #c9ff38;
+  --paper-accent: #c9a227;
+  --paper-font-body: "Spectral", ui-serif, Georgia, "Times New Roman", serif;
+  --paper-font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
+  --paper-font-thai: "IBM Plex Sans Thai", "Spectral", sans-serif;
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; padding: 0; background: var(--paper-bg); color: var(--paper-ink); }
+body { font-family: var(--paper-font-body); font-size: 18px; line-height: 1.7; -webkit-font-smoothing: antialiased; }
+
+a { color: var(--paper-ink); border-bottom: 1px solid var(--paper-ink); text-decoration: none; }
+a:hover { color: var(--paper-accent); border-color: var(--paper-accent); }
+
+code {
+  font-family: var(--paper-font-mono);
+  font-size: 0.88em;
+  background: rgba(17, 18, 15, 0.06);
+  padding: 1px 5px;
+}
+
+::selection { background: var(--paper-signal); color: var(--paper-ink); }
+
+.paper-header {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  padding: 22px 32px;
+  border-bottom: 1px solid var(--paper-rule);
+  background: var(--paper-bg);
+  position: sticky;
+  top: 0;
+  z-index: 5;
+}
+
+.paper-back {
+  font-family: var(--paper-font-mono);
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  border-bottom: none;
+}
+.paper-back:hover { color: var(--paper-accent); }
+.paper-eyebrow {
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--paper-muted);
+}
+
+.paper-main {
+  max-width: 760px;
+  margin: 0 auto;
+  padding: 48px 24px 96px;
+}
+
+.paper-article { font-family: var(--paper-font-body); }
+
+.paper-kicker {
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--paper-accent);
+  margin: 0 0 18px;
+}
+
+.paper-title {
+  font-family: var(--paper-font-body);
+  font-size: clamp(34px, 5vw, 56px);
+  font-weight: 800;
+  letter-spacing: -0.02em;
+  line-height: 1.05;
+  margin: 0 0 18px;
+}
+
+.paper-subtitle {
+  font-family: var(--paper-font-body);
+  font-style: italic;
+  font-size: 22px;
+  line-height: 1.5;
+  color: var(--paper-muted);
+  margin: 0 0 36px;
+  max-width: 660px;
+}
+
+.paper-byline {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 4px;
+  padding: 18px 0;
+  border-top: 1px solid var(--paper-ink);
+  border-bottom: 1px solid var(--paper-ink);
+  margin: 0 0 48px;
+}
+.paper-author {
+  font-family: var(--paper-font-body);
+  font-size: 22px;
+  font-weight: 800;
+  letter-spacing: -0.01em;
+}
+.paper-affiliation {
+  font-style: italic;
+  color: var(--paper-muted);
+  font-size: 15px;
+}
+.paper-meta {
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  color: var(--paper-muted);
+  margin-top: 8px;
+  letter-spacing: 0.04em;
+}
+
+.paper-section {
+  margin: 0 0 48px;
+}
+.paper-section h2 {
+  font-family: var(--paper-font-body);
+  font-size: 28px;
+  font-weight: 800;
+  letter-spacing: -0.02em;
+  line-height: 1.2;
+  margin: 0 0 16px;
+  padding-top: 24px;
+  border-top: 1px solid var(--paper-rule);
+}
+.paper-section p {
+  margin: 0 0 16px;
+  font-size: 18px;
+  line-height: 1.7;
+}
+.paper-section p:first-of-type::first-line {
+  font-weight: 600;
+}
+.paper-section ul, .paper-section ol {
+  margin: 0 0 16px;
+  padding-left: 24px;
+  font-size: 17px;
+  line-height: 1.7;
+}
+.paper-section li { margin-bottom: 6px; }
+.paper-section li strong { font-weight: 700; }
+
+.paper-references {
+  font-size: 15px;
+  line-height: 1.6;
+  color: var(--paper-muted);
+}
+.paper-references li { margin-bottom: 12px; }
+
+.paper-toc {
+  margin: 0 0 48px;
+  padding: 18px 0;
+  border-top: 1px solid var(--paper-rule);
+  border-bottom: 1px solid var(--paper-rule);
+}
+.paper-toc-kicker {
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--paper-accent);
+  margin: 0 0 10px;
+}
+.paper-toc ol {
+  margin: 0;
+  padding-left: 22px;
+  columns: 2;
+  gap: 24px;
+  font-size: 15px;
+  line-height: 1.7;
+}
+.paper-toc a { border-bottom-color: transparent; }
+.paper-toc a:hover { border-bottom-color: var(--paper-accent); }
+
+.paper-figure {
+  margin: 8px 0 28px;
+}
+.paper-figure img {
+  display: block;
+  width: 100%;
+  height: auto;
+  background: var(--paper-bg);
+  border: 1px solid var(--paper-rule);
+}
+.paper-figure figcaption {
+  font-family: var(--paper-font-body);
+  font-size: 14px;
+  font-style: italic;
+  color: var(--paper-muted);
+  margin-top: 8px;
+  line-height: 1.5;
+}
+
+.paper-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 15px;
+  margin: 8px 0 28px;
+}
+.paper-table caption {
+  text-align: left;
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--paper-muted);
+  margin-bottom: 8px;
+}
+.paper-table th,
+.paper-table td {
+  text-align: left;
+  padding: 8px 10px 8px 0;
+  border-bottom: 1px solid var(--paper-rule);
+  vertical-align: top;
+}
+.paper-table th {
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--paper-muted);
+  font-weight: 600;
+}
+
+.paper-pull {
+  margin: 8px 0 28px;
+  padding: 8px 0 8px 18px;
+  border-left: 3px solid var(--paper-ink);
+  font-style: italic;
+  font-size: 18px;
+  line-height: 1.55;
+}
+.paper-pull cite {
+  display: block;
+  margin-top: 10px;
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  font-style: normal;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--paper-muted);
+}
+
+.paper-note {
+  margin: 8px 0 28px;
+  padding: 16px 18px;
+  border: 1px solid var(--paper-ink);
+  background: rgba(201, 255, 56, 0.12);
+}
+.paper-note p { margin: 0; font-size: 16px; }
+
+.paper-meta-list li { margin-bottom: 14px; }
+
+.paper-index {
+  display: grid;
+  gap: 18px;
+  margin: 32px 0 48px;
+}
+.paper-index-card {
+  display: block;
+  padding: 22px 0;
+  border-top: 1px solid var(--paper-ink);
+  border-bottom: none;
+}
+.paper-index-card:hover { color: var(--paper-ink); }
+.paper-index-card small {
+  display: block;
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--paper-accent);
+  margin-bottom: 8px;
+}
+.paper-index-card strong {
+  display: block;
+  font-size: 26px;
+  font-weight: 800;
+  letter-spacing: -0.02em;
+  line-height: 1.15;
+  margin-bottom: 8px;
+}
+.paper-index-card span {
+  display: block;
+  font-style: italic;
+  color: var(--paper-muted);
+  font-size: 16px;
+  line-height: 1.5;
+}
+
+@media (max-width: 600px) {
+  .paper-toc ol { columns: 1; }
+}
+
+.paper-foot {
+  margin-top: 72px;
+  padding-top: 24px;
+  border-top: 2px solid var(--paper-ink);
+}
+.paper-foot p {
+  font-size: 15px;
+  line-height: 1.7;
+  color: var(--paper-muted);
+  margin: 0 0 8px;
+}
+.paper-foot code {
+  font-size: 0.92em;
+  background: rgba(17, 18, 15, 0.06);
+}
+.paper-foot-meta {
+  margin-top: 16px !important;
+  font-family: var(--paper-font-mono);
+  font-size: 11px !important;
+  letter-spacing: 0.04em;
+}
+
+.paper-page-wide .paper-main {
+  max-width: 1080px;
+}
+
+.catalog-table-wrap {
+  overflow-x: auto;
+  margin: 8px 0 28px;
+}
+.catalog-table {
+  min-width: 860px;
+  font-size: 14px;
+}
+.catalog-table td {
+  font-size: 14px;
+  line-height: 1.45;
+}
+.catalog-en {
+  display: block;
+  font-style: italic;
+}
+.catalog-th {
+  display: block;
+  font-family: var(--paper-font-thai);
+  font-size: 13px;
+  color: var(--paper-muted);
+  margin-top: 4px;
+}
+.catalog-notes {
+  margin: 8px 0 0 !important;
+  font-size: 12px !important;
+  color: var(--paper-muted);
+  font-style: italic;
+}
+.catalog-muted {
+  color: var(--paper-muted);
+  font-size: 12px;
+  border-bottom: none;
+}
+.catalog-flag {
+  display: inline-block;
+  margin: 6px 6px 0 0;
+  font-family: var(--paper-font-mono);
+  font-size: 10px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  padding: 2px 6px;
+  border: 1px solid var(--paper-rule);
+}
+.catalog-flag-phd {
+  border-color: var(--paper-ink);
+  background: rgba(201, 255, 56, 0.18);
+}
+.catalog-flag-nfv {
+  color: var(--paper-muted);
+}
+.catalog-access-pdf,
+.catalog-access-repo {
+  font-family: var(--paper-font-mono);
+  font-size: 11px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+.catalog-access-pdf { border-bottom-color: var(--paper-ink); }
+.catalog-access-repo { color: var(--paper-muted); }
+.catalog-table td:nth-child(3) .catalog-th {
+  display: inline;
+  margin-top: 0;
+}
+
+@media (max-width: 600px) {
+  .paper-main { padding: 24px 18px 60px; }
+  .paper-title { font-size: 32px; }
+  .paper-subtitle { font-size: 18px; }
+  .paper-section h2 { font-size: 22px; }
+  .paper-section p, .paper-section ul, .paper-section ol { font-size: 16px; }
+}
diff --git a/site/public/rowhouses/bible/paper.html b/site/public/rowhouses/bible/paper.html
new file mode 100644
index 0000000..a57bae7
--- /dev/null
+++ b/site/public/rowhouses/bible/paper.html
@@ -0,0 +1,970 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
+  <title>The row is the city — a Bangkok shophouse bible — Dr Non</title>
+  <meta name="description" content="Working paper 02: an operational shophouse bible for Bangkok. 1,656 surveyed units, 44 groups, five plans, three landlords — taken off the shelf and put on the atlas." />
+  <link rel="icon" href="/favicon.png" type="image/png" />
+  <link rel="canonical" href="https://bkk.nonarkara.org/rowhouses/bible/paper.html" />
+  <link rel="preconnect" href="https://fonts.googleapis.com" />
+  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans+Thai:wght@400;700&family=Spectral:ital,wght@0,400;0,600;0,800;1,400&display=swap" rel="stylesheet" />
+  <link rel="stylesheet" href="./paper.css" />
+</head>
+<body class="paper-page">
+  <header class="paper-header">
+    <a class="paper-back" href="/rowhouses">← Rowhouse atlas</a>
+    <span class="paper-eyebrow">Research paper · BKKxC(ulture) · 2026</span>
+  </header>
+
+  <main class="paper-main">
+    <article class="paper-article">
+      <p class="paper-kicker">A Bangkokian’s atlas · working paper 02 · ตึกแถว</p>
+      <h1 class="paper-title">The row is the city</h1>
+      <p class="paper-subtitle">
+        A shophouse bible for Bangkok. The papers already exist.
+        They stay on shelves. This one sits on the map.
+      </p>
+
+      <div class="paper-byline">
+        <div class="paper-author">Dr Non</div>
+        <div class="paper-affiliation">
+          Born Bangkok, 1981. BKKx / TKC / Axiom. Bangkok 10240.
+        </div>
+        <div class="paper-meta">
+          Version 2026-08-12 · Working paper 02 · Primary sources 2004–2026
+          · Atlas counts from <code>bkk-heritage-detail.geojson</code>
+        </div>
+      </div>
+
+      <nav class="paper-toc" aria-label="Paper contents">
+        <p class="paper-toc-kicker">Contents</p>
+        <ol>
+          <li><a href="#tldr">TL;DR</a></li>
+          <li><a href="#method">How this bible was built</a></li>
+          <li><a href="#meta">Seven meta-arguments</a></li>
+          <li><a href="#what">What a ตึกแถว is</a></li>
+          <li><a href="#import">Imported, not indigenous</a></li>
+          <li><a href="#survey">The 2001–02 survey</a></li>
+          <li><a href="#types">Five plans, not forty-four styles</a></li>
+          <li><a href="#arcade">The missing five-foot way</a></li>
+          <li><a href="#code">The 1979 envelope</a></li>
+          <li><a href="#ordinary">Ordinary urban heritage</a></li>
+          <li><a href="#landlord">The landlord problem</a></li>
+          <li><a href="#luenrit">Luenrit, Khao Hong, Old Siam</a></li>
+          <li><a href="#tourism">Tourism is a use change</a></li>
+          <li><a href="#atlas">What the atlas can and cannot see</a></li>
+          <li><a href="#use">How to use this bible</a></li>
+          <li><a href="#shelf">The shelf: recovered theses</a></li>
