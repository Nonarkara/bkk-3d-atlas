+          return `<li><a href="#${section.id}">${esc(section.id)} · ${esc(section.title)}</a>${claimed}</li>`;
+        }).join("");
+
+        document.getElementById("catalog-root").innerHTML = data.sections.map((section) => {
+          const rows = section.entries.map((entry) => {
+            const year = entry.year ?? "—";
+            const access = ACCESS_LABEL[entry.access] || entry.access;
+            const accessClass = entry.access === "direct-pdf" ? "catalog-access-pdf" : "catalog-access-repo";
+            const notes = entry.notes ? `<p class="catalog-notes">${esc(entry.notes)}</p>` : "";
+            return `<tr>
+              <td><code>${esc(entry.id)}</code></td>
+              <td>
+                ${titleBlock(entry)}
+                ${flags(entry)}
+                ${notes}
+              </td>
+              <td>${authorBlock(entry)}</td>
+              <td>${esc(entry.degree || "—")}<br><span class="catalog-muted">${esc(entry.university || "")}</span></td>
+              <td>${esc(year)}<br><span class="catalog-muted">${esc(entry.language || "")}</span></td>
+              <td>
+                <a class="${accessClass}" href="${esc(entry.url)}" rel="noreferrer">${esc(access)}</a>
+                ${entry.landing ? `<br><a class="catalog-muted" href="${esc(entry.landing)}" rel="noreferrer">landing page</a>` : ""}
+                ${entry.doi ? `<br><span class="catalog-muted">doi:${esc(entry.doi)}</span>` : ""}
+              </td>
+            </tr>`;
+          }).join("");
+
+          return `<section class="paper-section" id="${esc(section.id)}">
+            <h2>${esc(section.id)}. ${esc(section.title)}</h2>
+            <p>Recovered ${section.entries.length}${section.claimed != null ? ` of ${section.claimed} claimed` : ""}.</p>
+            <div class="catalog-table-wrap">
+              <table class="paper-table catalog-table">
+                <thead>
+                  <tr>
+                    <th>ID</th>
+                    <th>Title</th>
+                    <th>Author</th>
+                    <th>Degree / university</th>
+                    <th>Year</th>
+                    <th>Access</th>
+                  </tr>
+                </thead>
+                <tbody>${rows}</tbody>
+              </table>
+            </div>
+          </section>`;
+        }).join("");
+      })
+      .catch((error) => {
+        document.getElementById("catalog-root").innerHTML =
+          `<p>Could not load <a href="./catalog.json">catalog.json</a> (${esc(error.message)}).</p>`;
+      });
+  </script>
+</body>
+</html>
