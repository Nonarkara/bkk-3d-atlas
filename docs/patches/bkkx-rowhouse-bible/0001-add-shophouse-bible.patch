+  <text x="24" y="52" font-family="Georgia, serif" font-size="20" font-weight="700" fill="#11120f">The shelf, the landlord, the map</text>
+  <g font-family="ui-monospace, monospace" text-anchor="middle">
+    <rect x="36" y="80" width="200" height="160" fill="#11120f"/>
