# Names only. Do not put real secret values in git.
# Worker secrets (neither is a [vars] entry in wrangler.toml):
#   npx wrangler secret put LONGDO_KEY
#   npx wrangler secret put GOOGLE_MAPS_API_KEY
#   npx wrangler secret put GOOGLE_WEATHER_API_KEY
#
# LONGDO_KEY gates /api/traffic. Without it the route returns 200 and
# configured:false, and the client uses public/bkk-traffic-sample.geojson.
# GOOGLE_MAPS_API_KEY and GOOGLE_WEATHER_API_KEY are on the Env interface.
# /api/weather/google currently fetches Open-Meteo and does not call Google.
# The scoreboard treats either Google name as "configured" when set.
LONGDO_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_WEATHER_API_KEY=

# Public [vars] already committed in wrangler.toml. Not secrets.
LONGDO_FEED=
LONGDO_DATA_ORIGIN=

# Bindings, set in wrangler.toml / wrangler.cron.toml, not as dotenv values:
#   ASSETS, BKK_TILES (request Worker only), CIVIC_DB

# scripts/smoke-atlas-api.mjs — local smoke target. Not a Worker binding.
ATLAS_URL=

# scripts/deploy-live.sh
LIVE_URL=
DEPLOY_CACHE_WAIT_SECS=

# GitHub Actions secrets for .github/workflows/deploy-cloudflare.yml.
# Set them in the repository settings, not in this file.
#   CLOUDFLARE_API_TOKEN
#   CLOUDFLARE_ACCOUNT_ID
